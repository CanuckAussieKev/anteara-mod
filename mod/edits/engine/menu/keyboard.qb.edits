# The Anteara Mod's edits to engine\menu\keyboard.qb (applied to the game's own script: lib/edits.ts)
base bb69b11e
unit keyboard_button_pressed
= 1-4
+     if (<text> = "") {
= 3
+     } 
= 5-30
+     // MERGE: 2010 - the 2010 keyboard's symbol keys: [ ] { } ` * ^ & # ! typed button glyphs / "Anteara Mod".
+     // 2011 types those characters as they are; the 2010 menu's "KEYBOARD SYMBOLS (2010)" turns these on
+     if (anteara_2010_keyboard = 1) {
+         if (<text> = "[") {
+             <text> = "©" 
+         } 
+         if (<text> = "]") {
+             <text> = "®" 
+         } 
+         if (<text> = "{") {
+             <text> = "™" 
+         } 
+         if (<text> = "}") {
+             <text> = "¦" 
+         } 
+         if (<text> = "`") {
+             <text> = "%" 
+         } 
+         if (<text> = "*") {
+             <text> = "¬" 
+         } 
+         if (<text> = "^") {
+             <text> = "«" 
+         } 
+         if (<text> = "&") {
+             <text> = "œ" 
+         } 
+         if (<text> = "#") {
+             <text> = "\\cLA\\c4n\\cBt\\c4e\\cLa\\c4r\\cBa \\c4M\\cLo\\c4d" 
+         } 
+         if (<text> = "!") {
+             <text> = " \\cb™©®¦%¬«œ" 
+         } 
= 33-92
+
