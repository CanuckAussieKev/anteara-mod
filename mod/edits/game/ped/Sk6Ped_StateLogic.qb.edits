# Anteara Mod's edits to game\ped\Sk6Ped_StateLogic.qb (applied to the game's own script: lib/edits.ts)
base 2842f477
register
~ 1 6888 0  ped_chase_count
unit STATECONTROL_disgust
+ // MERGE: 2010 - 2010: a disgusted ped gives chase
= 1-8
+     Ped_SetLogicState STATE_chase Table=Ped_StateLogic_Table 
= 9-10
new ped_chase_count
after STATECONTROL_chasepause
+ // MERGE: 2010 - the pedestrian knock-down: knocks the skater down, counts and shows a message
+ // MERGE: (the counter's name, ped_chase_count, was also stored byte-reversed in 2010: #a3c76f73)
+ ped_chase_count = 0 
unit STATECONTROL_chasecatch
with 91e23e04 game\ped\Sk6Ped_StateLogic.qb STATECONTROL_blockerbump
= 1-2
= 3 @1
+     ped_chase_count (<ped_chase_count> + 1) 
= 3
+     // MERGE: FIX (never worked in the original) - 2010 compiled FormatText, TextName, text,
+     // create_console_message, rgba and wait_and_die in these two lines byte-reversed, so neither call ran.
+     // As written, the line above calls ped_chase_count instead of changing it (the count stays 0)
+     FormatText TextName=text "You suck!\\n%a Knock dows? " a=<ped_chase_count> 
+     create_console_message text=<text> rgba=[45 45 128 100] wait_and_die=1 time=3 
+     Wait 3 seconds 
+     Ped_SetLogicState STATE_DEFAULT 
= 4-7
~ 8 32 4 gohom
= 9-10
+
