+ } 
new FlyAi
after MakeSkaterFly
with bf4bd247 game\menu\skateshop.qb SkateshopAI
with 5a92f264 game\pro_anims.qb Skater_GoalInit
+ script FlyAi {move = 8 
= 11-12 @1
+     SetSpeed 0 
+     setstate Air 
= 15 @2
+     NoRailTricks 
+     while {
+         if Held R2 {
+             move Y=-6 
+         } 
+         if Held L1 {
+             move Y=6 
+         } 
+         if Held L2 {
+             if Held Square {
+                 move x=18 
+             } 
+             if Held Circle {
+                 move x=-18 
+             } 
+             if Held Triangle {
+                 move z=18 
+             } 
+             if Held x {
+                 move z=-18 
+             } 
+         } else {
+             if Held Square {
+                 move x=6 
+             } 
+             if Held Circle {
+                 move x=-6 
+             } 
+             if Held Triangle {
+                 move z=8 
+             } 
+             if Held x {
+                 move z=-8 
+             } 
+         } 
+         waitonegameframe 
+     } 
+     AllowRailTricks 
+     MakeSkaterGoto OnGroundAI 
+ } 
new obs_is_on
after FlyAi
+ obs_is_on = 0 
new anteara_observe_obs
after obs_is_on
with 7f1312f1 gamemodes\gamemode.qb create_rankings
+ script anteara_observe_obs {
+     switch obs_is_on
+         case 0 {
+             Skater:remove_skater_from_world 
+             EnterSurveyorMode 
+             Change obs_is_on=1 
+         }
+         case 1 {
= 14-15 @1
+             Change obs_is_on=0 
+         }
+     endswitch    
+ } 
